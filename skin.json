{
	"name": "bootstrapmediawiki",
	"version": "3.0",
	"author": "Matthew Batchelder",
	"url": "https://github.com/borkweb/bootstrap-mediawiki",
	"descriptionmsg": "Bootstrap MediaWiki",
	"namemsg": "Bootstrap MediaWiki",
	"license-name": "CC0-1.0",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"ValidSkinNames": {
		"bootstrapmediawiki": "bootstrapmediawiki"
	},
	"MessagesDirs": {
		"bootstrapmediawiki": [
			"i18n"
		]
	},
	"ResourceModules": {
		"skins.bootstrapmediawiki": {
			"styles": {
				"vendor/twbs/bootstrap/dist/css/bootstrap-reboot.min.css": {
					"media": "screen"
				},
				"vendor/twbs/bootstrap/dist/css/bootstrap-grid.min.css": {
					"media": "screen"
				},
				"vendor/twbs/bootstrap/dist/css/bootstrap.min.css": {
					"media": "screen"
				},
				"font-awesome/css/all.css": {
					"media": "screen"
				},
				"style.css": {
					"media": "screen"
				}
			}
		},
		"skins.bootstrapmediawiki.custom": {
			"styles": {
				"resources/custom.css": {
					"media": "screen"
				}
			}
		},
		"skins.bootstrapmediawiki.js": {
			"scripts": [
				"resources/main.js",
				"vendor/twbs/bootstrap/dist/js/bootstrap.bundle.min.js"
			]
		},
		"skins.bootstrapmediawiki.custom.js": {
			"scripts": [
				"resources/custom.js"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "bootstrapmediawiki"
	},
	"ResourceModuleSkinStyles": {
		"example": {
		"+ext.echo.styles.badge": "resources/extensions/echo.styles.badge.less"
		}
	},
	"AutoloadClasses": {
		"SkinBootstrapMediaWiki": "includes/SkinBootstrapMediaWiki.php",
		"BootstrapMediaWikiTemplate": "includes/BootstrapMediaWikiTemplate.php"
	},
	"config": {
		"bootstrapmediawikiNavBarClasses": {
			"value": "",
			"description": "Additional CSS classes for the navbar"
		},
		"bootstrapmediawikiTOCLocation": {
			"value": "default",
			"description": "Location of table of contents (default or sidebar)"
		},
		"bootstrapmediawikiCopyrightLink": {
			"value": null,
			"description": "URL for copyright link in footer (falls back to RightsUrl)"
		},
		"bootstrapmediawikiCopyright": {
			"value": null,
			"description": "Copyright text for footer (falls back to RightsText)"
		}
	},
	"manifest_version": 2
}
