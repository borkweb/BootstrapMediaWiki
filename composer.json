{
	"name": "borkweb/bootstrapmediawiki",
	"type": "mediawiki-skin",
	"description": "A MediaWiki skin based on Bootstrap 5",
	"keywords": [
		"wiki",
		"mediawiki",
		"skin",
		"bootstrap",
		"Twitter"
	],
	"license": "MIT",
	"homepage": "https://github.com/borkweb/bootstrapmediawiki",
	"authors": [
		{
			"name": "Matthew Batchelder",
			"email": "borkweb@gmail.com"
		}
	],
	"support": {
		"issues": "https://github.com/borkweb/bootstrapmediawiki/issues",
		"source": "https://github.com/borkweb/bootstrapmediawiki"
	},
	"require-dev": {
		"jakub-onderka/php-parallel-lint": "1.0.0",
		"jakub-onderka/php-console-highlighter": "0.3.2",
		"mediawiki/mediawiki-phan-config": "0.16.0",
		"mediawiki/mediawiki-codesniffer": "47.0.0"
	},
	"scripts": {
		"fix": [
			"phpcbf"
		],
		"test": [
			"phpcs -sp"
		]
	},
	"extra": {
		"phan-taint-check-plugin": "2.0.1"
	},
	"require": {
		"php": ">=8.1.0",
		"ext-dom": "*",
		"ext-filter": "*",
		"composer/installers": "^2|^1.0.12",
		"mediawiki/bootstrap": "^5.0",
		"jeroen/file-fetcher": "^6",
		"twbs/bootstrap": "^5.3"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
